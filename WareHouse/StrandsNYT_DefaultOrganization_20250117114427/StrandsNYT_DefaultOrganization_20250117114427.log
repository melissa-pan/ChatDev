        self.text = text
    
    def get_text(self):
        return self.text
```

#### game_logic.py

```python
'''

Contains the GameLogic class for managing the logic of the NYT Strands puzzle game.

'''

class GameLogic:
    def __init__(self, segments):
        self.segments = segments
    
    def is_valid_solution(self, selected_segments):
        # Example valid solution: "python programming"
        valid_solution = "python programming"
        selected_text = "".join(segment.get_text() for segment in selected_segments)
        return selected_text == valid_solution
```

