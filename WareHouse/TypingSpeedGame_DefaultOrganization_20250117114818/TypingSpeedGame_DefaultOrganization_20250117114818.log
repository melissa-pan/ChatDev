            self.entry.delete(0, tk.END)
        if self.timer.get_elapsed_time() >= 60:
            self.end_game()
    def end_game(self):
        wpm = self.calculate_wpm(self.typed_text, self.timer.get_elapsed_time())
        accuracy = self.calculate_accuracy(self.typed_text, self.current_word)
        self.result_label.config(text=f"WPM: {wpm}, Accuracy: {accuracy}%")
    def calculate_wpm(self, typed_text, elapsed_time):
        words_typed = len(typed_text.split())
        minutes = elapsed_time / 60
        return round(words_typed / minutes)
    def calculate_accuracy(self, typed_text, correct_text):
        correct_chars = sum(1 for i, c in enumerate(typed_text) if i < len(correct_text) and c == correct_text[i])
        return round((correct_chars / len(correct_text)) * 100, 2)
    def run(self):
        self.root.mainloop()
