        '''
        Increases the score by one.
        '''
        self.value += 1
    def draw(self, screen):
        '''
        Draws the current score on the screen.
        '''
        score_surface = self.font.render(f'Score: {self.value}', True, (255, 255, 255))
        screen.blit(score_surface, (10, 10))
