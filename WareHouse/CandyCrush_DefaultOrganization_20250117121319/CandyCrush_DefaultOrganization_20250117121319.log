import pygame
import random
from candy import Candy
class Board:
    def __init__(self):
        self.rows = 8
        self.cols = 8
        self.candies = [[Candy(random.randint(0, 5), (x, y)) for x in range(self.cols)] for y in range(self.rows)]
        self.matches = set()
