        info = "\n".join([f"{player.name}: ${player.money}" for player in self.game.players])
        self.info_label.config(text=info)
        self.root.update()

    def prompt_player_action(self, player):
        roll = self.roll_dice()
        player.move(roll)
        property = self.game.board.get_property(player.position)
