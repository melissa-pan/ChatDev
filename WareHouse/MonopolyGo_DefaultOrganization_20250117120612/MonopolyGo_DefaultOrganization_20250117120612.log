        else:
            property.charge_rent(player)
        if random.choice([True, False]):  # Randomly decide if a chance card is drawn
            self.game.board.draw_chance_card(player)
    def roll_dice(self):
        import random
        return random.randint(1, 6)
    def run(self):
        self.root.mainloop()
