import pygame
class Scoreboard:
    def __init__(self):
        self.score = 0
        self.time_left = 60  # 60 seconds for each level
        self.font = pygame.font.Font(None, 36)
        self.start_ticks = pygame.time.get_ticks()  # Start time
    def update_score(self, claw, objects):
