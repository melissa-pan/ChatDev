'''
Claw class to handle movement and grabbing.
'''
import pygame
class Claw:
    def __init__(self):
        self.position = [400, 50]
        self.direction = 1
        self.grabbing = False
    def move(self):
        if not self.grabbing:
            self.position[0] += self.direction * 5
            if self.position[0] <= 0 or self.position[0] >= 800:
                self.direction *= -1
    def grab(self, objects):
        self.grabbing = True
        # Logic to check if an object is grabbed
        for obj in objects:
            if self.position[0] in range(obj.position[0] - 10, obj.position[0] + 10):
                # Simulate grabbing the object
                objects.remove(obj)
                self.grabbing = False
                break
    def draw(self, screen):
        pygame.draw.line(screen, (255, 255, 255), (self.position[0], self.position[1]), (self.position[0], self.position[1] + 50), 2)
