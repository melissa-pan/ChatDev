                for dr in [-1, 0, 1]:
                    for dc in [-1, 0, 1]:
                        if dr == 0 and dc == 0:
                            continue
                        nr, nc = r + dr, c + dc
                        if 0 <= nr < self.rows and 0 <= nc < self.cols and self.board[nr][nc] == -1:
                            count += 1
                self.board[r][c] = count
    def uncover_cell(self, r, c):
        if (r, c) in self.uncovered:
            return True
        if (r, c) in self.mine_positions:
            return False  # Indicate that a mine was uncovered
        self.uncovered.add((r, c))
        if self.board[r][c] == 0:
            for dr in [-1, 0, 1]:
                for dc in [-1, 0, 1]:
                    if dr == 0 and dc == 0:
                        continue
                    nr, nc = r + dr, c + dc
                    if 0 <= nr < self.rows and 0 <= nc < self.cols:
                        self.uncover_cell(nr, nc)
        return True
    def check_win(self):
        return len(self.uncovered) == self.rows * self.cols - self.mines
