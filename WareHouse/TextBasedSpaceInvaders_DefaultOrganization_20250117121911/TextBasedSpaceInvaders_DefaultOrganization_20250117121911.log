To implement a simplified Space Invaders game in Python, we'll use the Pygame library, which is well-suited for creating 2D games with graphical interfaces. Below is a step-by-step outline of the core classes and functions needed for the game, followed by the complete code for each file.

### Core Classes and Functions

1. **Game**: The main class to initialize and run the game loop.
   - `__init__()`: Initialize game settings, screen, and create game objects.
   - `run_game()`: Main loop to keep the game running, handle events, update game state, and render graphics.

2. **Ship**: Represents the player's ship.
   - `__init__()`: Initialize the ship's position and settings.
   - `update()`: Update the ship's position based on user input.
   - `blitme()`: Draw the ship at its current location.

3. **Alien**: Represents a single alien.
   - `__init__()`: Initialize the alien's position and settings.
   - `update()`: Move the alien down the screen.
   - `blitme()`: Draw the alien at its current location.

4. **Bullet**: Represents a bullet fired by the ship.
   - `__init__()`: Initialize the bullet's position and settings.
   - `update()`: Move the bullet up the screen.
   - `draw_bullet()`: Draw the bullet on the screen.

5. **Settings**: A class to store all settings for the game.
   - `__init__()`: Initialize game settings like screen size, ship speed, bullet speed, etc.

6. **Functions**:
   - `check_events()`: Handle keypresses and mouse events.
   - `update_screen()`: Update images on the screen and flip to the new screen.
   - `check_bullet_alien_collisions()`: Check for collisions between bullets and aliens.

### Code Implementation

#### main.py

```python
'''

Main module to run the Space Invaders game using Pygame.

'''

import pygame
from settings import Settings
from ship import Ship
from alien import Alien
from bullet import Bullet
import game_functions as gf

def run_game():
    # Initialize game and create a screen object
    pygame.init()
    ai_settings = Settings()
    screen = pygame.display.set_mode((ai_settings.screen_width, ai_settings.screen_height))
    pygame.display.set_caption("Space Invaders")

    # Create an instance of Ship, Alien, and a group for bullets
    ship = Ship(ai_settings, screen)
    alien = Alien(ai_settings, screen)
    bullets = pygame.sprite.Group()

    # Start the main loop for the game
    while True:
        gf.check_events(ai_settings, screen, ship, bullets)
        ship.update()
        gf.update_bullets(bullets, alien)
        alien.update()
        gf.update_screen(ai_settings, screen, ship, alien, bullets)

if __name__ == '__main__':
    run_game()
```

#### settings.py

```python
'''

Settings module to store all settings for the Space Invaders game.

'''

class Settings:
    def __init__(self):
        '''Initialize the game's settings.'''
        # Screen settings
        self.screen_width = 800
        self.screen_height = 600
        self.bg_color = (230, 230, 230)

        # Ship settings
        self.ship_speed_factor = 1.5

        # Bullet settings
        self.bullet_speed_factor = 3
        self.bullet_width = 3
        self.bullet_height = 15
        self.bullet_color = 60, 60, 60
        self.bullets_allowed = 3

        # Alien settings
        self.alien_speed_factor = 1
```

#### ship.py

```python
'''

Ship module to represent the player's ship in the Space Invaders game.

'''

import pygame

class Ship:
    def __init__(self, ai_settings, screen):
        '''Initialize the ship and set its starting position.'''
        self.screen = screen
        self.ai_settings = ai_settings

        # Load the ship image and get its rect.
        self.image = pygame.image.load('ship.bmp')
        self.rect = self.image.get_rect()
        self.screen_rect = screen.get_rect()

        # Start each new ship at the bottom center of the screen.
        self.rect.centerx = self.screen_rect.centerx
        self.rect.bottom = self.screen_rect.bottom

        # Store a decimal value for the ship's center.
        self.center = float(self.rect.centerx)

        # Movement flag
        self.moving_right = False
        self.moving_left = False

    def update(self):
        '''Update the ship's position based on movement flags.'''
        if self.moving_right and self.rect.right < self.screen_rect.right:
            self.center += self.ai_settings.ship_speed_factor
        if self.moving_left and self.rect.left > 0:
            self.center -= self.ai_settings.ship_speed_factor

        # Update rect object from self.center.
        self.rect.centerx = self.center

    def blitme(self):
        '''Draw the ship at its current location.'''
        self.screen.blit(self.image, self.rect)
```

#### alien.py

```python
'''

Alien module to represent a single alien in the Space Invaders game.

'''

import pygame
from pygame.sprite import Sprite

class Alien(Sprite):
    def __init__(self, ai_settings, screen):
        '''Initialize the alien and set its starting position.'''
        super(Alien, self).__init__()
        self.screen = screen
        self.ai_settings = ai_settings

        # Load the alien image and set its rect attribute.
        self.image = pygame.image.load('alien.bmp')
        self.rect = self.image.get_rect()

        # Start each new alien near the top left of the screen.
        self.rect.x = self.rect.width
        self.rect.y = self.rect.height

        # Store the alien's exact position.
        self.x = float(self.rect.x)

    def update(self):
        '''Move the alien down.'''
        self.rect.y += self.ai_settings.alien_speed_factor

    def blitme(self):
        '''Draw the alien at its current location.'''
        self.screen.blit(self.image, self.rect)
```

#### bullet.py

```python
'''

Bullet module to represent bullets fired from the ship in the Space Invaders game.

'''

import pygame
from pygame.sprite import Sprite

class Bullet(Sprite):
    def __init__(self, ai_settings, screen, ship):
        '''Create a bullet object at the ship's current position.'''
        super(Bullet, self).__init__()
        self.screen = screen

        # Create a bullet rect at (0, 0) and then set correct position.
        self.rect = pygame.Rect(0, 0, ai_settings.bullet_width, ai_settings.bullet_height)
        self.rect.centerx = ship.rect.centerx
        self.rect.top = ship.rect.top

        # Store the bullet's position as a decimal value.
        self.y = float(self.rect.y)

        self.color = ai_settings.bullet_color
        self.speed_factor = ai_settings.bullet_speed_factor

    def update(self):
        '''Move the bullet up the screen.'''
        # Update the decimal position of the bullet.
        self.y -= self.speed_factor
        # Update the rect position.
        self.rect.y = self.y

    def draw_bullet(self):
        '''Draw the bullet to the screen.'''
        pygame.draw.rect(self.screen, self.color, self.rect)
```

#### game_functions.py

```python
'''

Game functions module to handle events and updates in the Space Invaders game.

'''

import sys
import pygame
from bullet import Bullet

def check_events(ai_settings, screen, ship, bullets):
    '''Respond to keypresses and mouse events.'''
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            sys.exit()
        elif event.type == pygame.KEYDOWN:
            check_keydown_events(event, ai_settings, screen, ship, bullets)
        elif event.type == pygame.KEYUP:
            check_keyup_events(event, ship)

def check_keydown_events(event, ai_settings, screen, ship, bullets):
    '''Respond to keypresses.'''
    if event.key == pygame.K_RIGHT:
        ship.moving_right = True
    elif event.key == pygame.K_LEFT:
        ship.moving_left = True
    elif event.key == pygame.K_SPACE:
        fire_bullet(ai_settings, screen, ship, bullets)
    elif event.key == pygame.K_q:
        sys.exit()

def check_keyup_events(event, ship):
    '''Respond to key releases.'''
    if event.key == pygame.K_RIGHT:
        ship.moving_right = False
    elif event.key == pygame.K_LEFT:
        ship.moving_left = False

def fire_bullet(ai_settings, screen, ship, bullets):
    '''Fire a bullet if limit not reached yet.'''
    # Create a new bullet and add it to the bullets group.
    if len(bullets) < ai_settings.bullets_allowed:
        new_bullet = Bullet(ai_settings, screen, ship)
        bullets.add(new_bullet)

def update_bullets(bullets, alien):
    '''Update position of bullets and get rid of old bullets.'''
    # Update bullet positions.
    bullets.update()

    # Get rid of bullets that have disappeared.
    for bullet in bullets.copy():
        if bullet.rect.bottom <= 0:
            bullets.remove(bullet)

    # Check for any bullets that have hit aliens.
    # If so, get rid of the bullet and the alien.
    if pygame.sprite.spritecollideany(alien, bullets):
        bullets.remove(pygame.sprite.spritecollideany(alien, bullets))
        alien.kill()

def update_screen(ai_settings, screen, ship, alien, bullets):
    '''Update images on the screen and flip to the new screen.'''
    # Redraw the screen during each pass through the loop.
    screen.fill(ai_settings.bg_color)
    # Redraw all bullets behind ship and aliens.
    for bullet in bullets.sprites():
        bullet.draw_bullet()
    ship.blitme()
    alien.blitme()

    # Make the most recently drawn screen visible.
    pygame.display.flip()
```

### Additional Notes
- Ensure you have the images `ship.bmp` and `alien.bmp` in the same directory as your code files for the game to display the ship and aliens correctly.
- You may need to install Pygame if you haven't already. You can do this using `pip install pygame`.
- This implementation is a basic version of Space Invaders. You can expand it by adding more aliens, levels, and features like scoring and sound effects.

