import pygame
from monster import Monster
from treasure import Treasure
from door import Door

class Map:
    def __init__(self):
        self.width = 80
        self.height = 80
        self.grid = [[None for _ in range(self.width)] for _ in range(self.height)]
        self.start_x = 0
        self.start_y = 0
        self.generate_map()

    def generate_map(self):
        # Simplified map generation
        for x in range(self.width):
            for y in range(self.height):
                if x == 0 or y == 0 or x == self.width - 1 or y == self.height - 1:
                    self.grid[x][y] = 'wall'
                else:
                    self.grid[x][y] = 'floor'
        # Place monsters, treasures, and a door
        self.grid[10][10] = Monster(20)
        self.grid[15][15] = Treasure()
        self.grid[20][20] = Door()

    def is_walkable(self, x, y):
        return self.grid[x][y] == 'floor' or isinstance(self.grid[x][y], (Monster, Treasure, Door))

    def get_object_at(self, x, y):
        if isinstance(self.grid[x][y], (Monster, Treasure, Door)):
            return self.grid[x][y]
        return None

    def draw(self, screen):
        for x in range(self.width):
            for y in range(self.height):
                if self.grid[x][y] == 'wall':
                    pygame.draw.rect(screen, (255, 255, 255), (x * 10, y * 10, 10, 10))
                elif self.grid[x][y] == 'floor':
                    pygame.draw.rect(screen, (50, 50, 50), (x * 10, y * 10, 10, 10))
